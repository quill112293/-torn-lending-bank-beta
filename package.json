{
  "name": "torn-lending-bank-beta",
  "version": "1.1.0-beta.36",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/test-push-runtime.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/check-deployment.mjs && npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "wrangler": "4.92.0"
  }
}

